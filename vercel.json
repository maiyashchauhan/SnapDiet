{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "python",
      "entrypoint": "web:app",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_URL"
        }
      ]
    },
    "api": {
      "root": "api",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "api",
        "path": "/"
      }
    },
    {
      "source": "/api/docs",
      "destination": {
        "service": "api",
        "path": "/docs"
      }
    },
    {
      "source": "/api/openapi.json",
      "destination": {
        "service": "api",
        "path": "/openapi.json"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api",
        "path": "/$1"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app",
        "path": "/$1"
      }
    }
  ]
}
